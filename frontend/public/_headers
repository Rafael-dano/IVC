/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # temporarily comment HSTS until HTTPS is provisioned, then re-enable:
  # Strict-Transport-Security: max-age=31536000; includeSubDomains

  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://js.stripe.com https://us-assets.i.posthog.com; connect-src 'self' https://api.ivcontent.com https://*.supabase.co https://us.i.posthog.com https://api.stripe.com https://js.stripe.com; frame-src https://js.stripe.com https://www.youtube.com


/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800